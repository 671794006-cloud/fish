"use client";

import { useState, useEffect } from "react";
import Link from "next/link";
import { createClient } from "@supabase/supabase-js";

// ใส่ URL ตรงๆ สำรองไว้เผื่อลืมตั้งค่า Environment
const supabaseUrl = process.env.NEXT_PUBLIC_SUPABASE_URL || "https://grilvqiyczvdkfumxxqy.supabase.co";
const supabaseAnonKey = process.env.NEXT_PUBLIC_SUPABASE_ANON_KEY || "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImdyaWx2cWl5Y3p2ZGtmdW14eHF5Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODUxMjM0NjIsImV4cCI6MjEwMDY5OTQ2Mn0.xoT69q46aqz6SAXNsiDLUd4BEyf2Q4yfB9teuEHYktM";

const supabase = createClient(supabaseUrl, supabaseAnonKey);

export default function AdminPage() {
  const [loading, setLoading] = useState(true);
  const [isAdmin, setIsAdmin] = useState(false);
  const [user, setUser] = useState<any>(null);
  const [activeTab, setActiveTab] = useState<"orders" | "admins">("orders");
  
  const [orders, setOrders] = useState<any[]>([]);
  const [adminList, setAdminList] = useState<any[]>([]);
  const [newAdminEmail, setNewAdminEmail] = useState("");
  const [toastMessage, setToastMessage] = useState("");

  const showToast = (msg: string) => {
    setToastMessage(msg);
    setTimeout(() => setToastMessage(""), 2000);
  };

  useEffect(() => {
    checkAdminAccess();
  }, []);

  // 🌟 ฟังก์ชันตรวจสอบสิทธิ์แอดมิน
  const checkAdminAccess = async () => {
    const { data: { session } } = await supabase.auth.getSession();
    if (!session) {
      window.location.href = "/login";
      return;
    }
    
    setUser(session.user);

    // ตรวจสอบว่าอีเมลนี้อยู่ในตาราง admins หรือไม่
    const { data: adminData } = await supabase
      .from("admins")
      .select("*")
      .eq("email", session.user.email)
      .single();

    if (adminData) {
      setIsAdmin(true);
      fetchOrders();
      fetchAdmins();
    }
    setLoading(false);
  };

  const fetchOrders = async () => {
    const { data } = await supabase
      .from("orders")
      .select("*")
      .order("created_at", { ascending: false }); // ดึงออเดอร์ล่าสุดขึ้นก่อน
    if (data) setOrders(data);
  };

  const fetchAdmins = async () => {
    const { data } = await supabase
      .from("admins")
      .select("*")
      .order("created_at", { ascending: true });
    if (data) setAdminList(data);
  };

  // 🌟 ฟังก์ชันเปลี่ยนสถานะสินค้า (กำลังจัดส่ง, จัดส่งสำเร็จ)
  const updateOrderStatus = async (orderId: number, newStatus: string) => {
    const { error } = await supabase
      .from("orders")
      .update({ status: newStatus })
      .eq("id", orderId);

    if (error) {
      alert("อัปเดตสถานะไม่สำเร็จ: " + error.message);
    } else {
      showToast("✅ อัปเดตสถานะสำเร็จ ลูกค้าจะเห็นสถานะใหม่ทันที!");
      setOrders(orders.map(o => o.id === orderId ? { ...o, status: newStatus } : o));
    }
  };

  // 🌟 ฟังก์ชันเพิ่มอีเมลเพื่อนมาเป็นแอดมิน
  const handleAddAdmin = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!newAdminEmail.trim()) return;

    const { error } = await supabase.from("admins").insert([{ email: newAdminEmail }]);

    if (error) {
      alert("ไม่สามารถเพิ่มแอดมินได้ (อีเมลนี้อาจมีอยู่แล้ว หรือพิมพ์ผิดครับ)");
    } else {
      showToast("✅ เพิ่มแอดมินใหม่เรียบร้อย!");
      setNewAdminEmail("");
      fetchAdmins();
    }
  };

  const handleRemoveAdmin = async (id: number, email: string) => {
    if (email === user.email) {
      alert("❌ คุณไม่สามารถลบตัวเองออกจากระบบได้ครับ!");
      return;
    }
    if (!window.confirm(`ยืนยันการลบสิทธิ์แอดมินของ\n${email} ?`)) return;

    const { error } = await supabase.from("admins").delete().eq("id", id);
    if (!error) {
      showToast("🗑️ ลบแอดมินสำเร็จ");
      fetchAdmins();
    }
  };

  const formatDate = (dateString: string) => {
    const d = new Date(dateString);
    return d.toLocaleDateString('th-TH', { year: 'numeric', month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' });
  };

  if (loading) return <div className="min-h-screen bg-gray-50 flex items-center justify-center font-sans font-bold text-gray-500">กำลังตรวจสอบสิทธิ์...</div>;

  // 🔴 หน้าจอเตะออก หากไม่ใช่แอดมิน
  if (!isAdmin) {
    return (
      <div className="min-h-screen flex flex-col items-center justify-center bg-gray-100 p-4 text-center font-sans">
        <div className="bg-white p-8 rounded-3xl shadow-xl max-w-md w-full border-t-4 border-red-500">
          <div className="w-20 h-20 bg-red-100 text-red-500 rounded-full flex items-center justify-center mx-auto mb-4">
            <svg className="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="3" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
          </div>
          <h1 className="text-2xl font-bold text-gray-800 mb-2">Access Denied</h1>
          <p className="text-gray-500 mb-6">ขออภัย บัญชีของคุณ <b>{user?.email}</b> <br/>ไม่มีสิทธิ์เข้าถึงระบบหลังบ้านครับ</p>
          <Link href="/" className="bg-[#0a4a2f] text-[#f3c623] px-6 py-3 rounded-xl font-bold w-full block hover:bg-[#073622] transition">
            กลับหน้าร้านค้า
          </Link>
        </div>
      </div>
    );
  }

  // 🟢 หน้าจอหลังบ้าน (เมื่อเข้าผ่านแอดมินสำเร็จ)
  return (
    <div className="min-h-screen bg-gray-50 font-sans pb-20 relative">
      
      {toastMessage && (
        <div className="fixed top-24 left-1/2 -translate-x-1/2 bg-[#0a4a2f] text-[#f3c623] px-6 py-3 rounded-full shadow-2xl z-[100] font-bold text-sm flex items-center gap-2 animate-bounce">
          {toastMessage}
        </div>
      )}

      {/* Navbar ระบบหลังบ้าน */}
      <nav className="bg-[#0a4a2f] text-white p-4 shadow-md sticky top-0 z-50 flex justify-between items-center px-6">
        <div className="font-bold text-lg md:text-xl flex items-center gap-2">
          <span className="bg-[#f3c623] text-[#0a4a2f] px-2 py-1 rounded-lg text-xs md:text-sm font-extrabold uppercase">Admin</span>
          ระบบจัดการร้านค้า
        </div>
        <Link href="/" className="text-sm font-medium hover:text-[#f3c623] transition bg-white/10 px-4 py-2 rounded-full border border-white/20">
          ดูหน้าร้านค้า
        </Link>
      </nav>

      <div className="max-w-5xl mx-auto px-4 mt-6">
        
        {/* แถบสลับเมนู */}
        <div className="flex gap-2 mb-6">
          <button 
            onClick={() => setActiveTab("orders")} 
            className={`flex-1 py-3.5 rounded-2xl font-bold text-sm md:text-base transition ${activeTab === "orders" ? "bg-[#0a4a2f] text-[#f3c623] shadow-md border-2 border-[#0a4a2f]" : "bg-white text-gray-500 border border-gray-200 hover:bg-gray-50"}`}
          >
            📦 รายการออเดอร์
          </button>
          <button 
            onClick={() => setActiveTab("admins")} 
            className={`flex-1 py-3.5 rounded-2xl font-bold text-sm md:text-base transition ${activeTab === "admins" ? "bg-[#0a4a2f] text-[#f3c623] shadow-md border-2 border-[#0a4a2f]" : "bg-white text-gray-500 border border-gray-200 hover:bg-gray-50"}`}
          >
            🔑 ผู้ดูแลระบบ (Admins)
          </button>
        </div>

        {/* 📦 Tab: จัดการออเดอร์ */}
        {activeTab === "orders" && (
          <div className="space-y-4">
            {orders.length === 0 ? (
              <div className="bg-white rounded-3xl p-12 text-center border border-dashed border-gray-300">
                <p className="text-gray-500 font-bold">ยังไม่มีออเดอร์เข้ามาในระบบครับ</p>
              </div>
            ) : (
              orders.map((order) => (
                <div key={order.id} className="bg-white rounded-2xl shadow-sm border border-gray-200 p-4 md:p-6 flex flex-col md:flex-row md:items-center justify-between gap-4">
                  
                  {/* ข้อมูลออเดอร์ */}
                  <div className="flex-1">
                    <div className="flex items-center gap-2 mb-2">
                      <span className="bg-gray-100 text-gray-600 px-2 py-1 rounded font-bold text-xs">ID: {order.id}</span>
                      <span className="text-xs text-gray-400">📅 {formatDate(order.created_at)}</span>
                    </div>
                    
                    <div className="space-y-1 mt-3">
                      {order.items.map((item: any, i: number) => (
                        <div key={i} className="text-sm font-medium text-gray-800 flex items-center gap-2">
                          <span className="w-1.5 h-1.5 bg-green-500 rounded-full inline-block"></span>
                          {item.name} <span className="text-orange-600 font-extrabold ml-auto">x{item.qty}</span>
                        </div>
                      ))}
                    </div>
                    <div className="mt-3 text-lg font-bold text-gray-900">
                      ยอดสุทธิ: <span className="text-red-500">฿{order.total_price}</span>
                    </div>
                  </div>

                  {/* ตัวเลือกเปลี่ยนสถานะ */}
                  <div className="bg-gray-50 p-3 rounded-xl border border-gray-100 shrink-0 w-full md:w-auto">
                    <label className="text-xs text-gray-500 font-bold block mb-1">สถานะปัจจุบัน:</label>
                    <select
                      value={order.status}
                      onChange={(e) => updateOrderStatus(order.id, e.target.value)}
                      className={`w-full outline-none border-2 font-bold text-sm rounded-xl px-4 py-2.5 cursor-pointer appearance-none ${
                        order.status === 'รอดำเนินการ' ? 'bg-orange-50 text-orange-600 border-orange-200' :
                        order.status === 'กำลังจัดส่ง' ? 'bg-blue-50 text-blue-600 border-blue-200' :
                        order.status === 'จัดส่งสำเร็จ' ? 'bg-green-50 text-green-600 border-green-200' :
                        'bg-red-50 text-red-600 border-red-200'
                      }`}
                    >
                      <option value="รอดำเนินการ">🟠 รอดำเนินการ</option>
                      <option value="กำลังจัดส่ง">🔵 กำลังจัดส่ง</option>
                      <option value="จัดส่งสำเร็จ">🟢 จัดส่งสำเร็จ</option>
                      <option value="ยกเลิกแล้ว">🔴 ยกเลิกแล้ว</option>
                    </select>
                  </div>

                </div>
              ))
            )}
          </div>
        )}

        {/* 🔑 Tab: จัดการแอดมิน */}
        {activeTab === "admins" && (
          <div className="grid grid-cols-1 md:grid-cols-2 gap-6 items-start">
            
            <div className="bg-white p-6 rounded-3xl shadow-sm border border-gray-200">
              <h3 className="font-bold text-lg text-[#0a4a2f] mb-4">เพิ่มแอดมินใหม่</h3>
              <form onSubmit={handleAddAdmin} className="space-y-3">
                <input 
                  type="email" 
                  required 
                  value={newAdminEmail} 
                  onChange={(e) => setNewAdminEmail(e.target.value)} 
                  placeholder="กรอกอีเมลแอดมิน..." 
                  className="w-full p-3 border border-gray-300 rounded-xl outline-none focus:ring-2 focus:ring-green-600 bg-gray-50"
                />
                <button type="submit" className="w-full bg-[#0a4a2f] text-[#f3c623] font-bold py-3 rounded-xl hover:bg-[#073622] transition shadow-md">
                  เพิ่มสิทธิ์แอดมิน
                </button>
              </form>
            </div>

            <div className="bg-white p-6 rounded-3xl shadow-sm border border-gray-200">
              <h3 className="font-bold text-lg text-[#0a4a2f] mb-4">รายชื่อผู้ดูแลระบบ</h3>
              <div className="space-y-3 max-h-80 overflow-y-auto pr-2">
                {adminList.map((admin) => (
                  <div key={admin.id} className="flex justify-between items-center p-3 bg-gray-50 rounded-xl border border-gray-100">
                    <span className="font-semibold text-gray-700 text-sm truncate pr-2">
                      {admin.email} {admin.email === user.email && <span className="text-xs bg-green-200 text-green-800 px-2 py-0.5 rounded-full ml-1">คุณ</span>}
                    </span>
                    <button 
                      onClick={() => handleRemoveAdmin(admin.id, admin.email)}
                      className="text-red-500 hover:bg-red-100 p-2 rounded-lg transition shrink-0"
                      title="ลบสิทธิ์"
                    >
                      <svg className="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                    </button>
                  </div>
                ))}
              </div>
            </div>

          </div>
        )}

      </div>
    </div>
  );
}
